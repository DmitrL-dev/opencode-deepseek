# Copy this file to .env. Sign-in is done by hand in a browser window
# (run `python -m deepseek.auth` or `python -m qwen.auth`), so no credentials are stored here.
# All providers are opt-in. DeepSeek web automation may restrict your account.
DEEPSEEK_ENABLED=0
# Minimum seconds between starts of attempts/continuations (durable across processes).
# DeepSeek also spaces HTTP dispatches by up to 3 seconds and enforces durable
# default rolling budgets: 12 generations/hour, 60/day; 3 new chats/hour, 6/day;
# 40 HTTP requests/hour, 200/day. These are local ceilings, not safe quotas.
# This is pacing, not a guarantee of acceptable use or website quota.
PROVIDER_MIN_INTERVAL=30
# Configurable DeepSeek ceilings. Integers 1..1000; day >= hour for each kind.
# Restart to apply. Existing usage is preserved; website quotas are independent.
DEEPSEEK_MAX_GENERATIONS_PER_HOUR=12
DEEPSEEK_MAX_GENERATIONS_PER_DAY=60
DEEPSEEK_MAX_CHATS_PER_HOUR=3
DEEPSEEK_MAX_CHATS_PER_DAY=6
DEEPSEEK_MAX_HTTP_PER_HOUR=40
DEEPSEEK_MAX_HTTP_PER_DAY=200
# Accepted replies per saved stateless conversation; integer 1..1000.
# Raising preserves existing history and one-use continuation protection.
DEEPSEEK_MAX_CONVERSATION_REPLIES=20
# Optional Qwen Chat models: run `python -m qwen.auth`, then set QWEN_ENABLED=1.
# Qwen uses a separate profile and session under session/qwen/.
QWEN_ENABLED=0
# Optional: before a new request, renew a locally expired Qwen access token
# once using its existing website refresh cookie. No browser/background work,
# no replay after refusal; failures persist a pause. See docs/HARNESS.en.md.
QWEN_RENEW_SESSION=0
# QWEN_PROFILE_DIR=/absolute/path/to/a/dedicated/qwen/profile

# Experimental signed-in browser tabs (Safari Userscripts or a compatible manager).
# Read browser/README.md before enabling. Each uses the web UI's selected model.
BROWSER_BRIDGE_ENABLED=0
GROK_ENABLED=0
MISTRAL_ENABLED=0
KIMI_ENABLED=0
# Optional direct Kimi Instant transport; browser remains necessary for manual
# initial session capture only. See docs/KIMI.md for qualification and setup.
# Session renewal is a separate opt-in and never follows a provider refusal.
KIMI_TRANSPORT=browser
KIMI_RENEW_SESSION=0
GLM_ENABLED=0
# WEB_PROVIDER_TIMEOUT=180

# Gemini uses the official Antigravity CLI, with tools disabled.
# Sign in with `agy`; obtain real account model slugs with `agy models`.
GEMINI_ENABLED=0
GEMINI_MODELS={}
# ANTIGRAVITY_BIN=agy
# For a broken IPv6 socket only, providers.antigravity_ipv4 wraps the official
# CLI using IPv4 on your existing route, without changing system/VPN settings.

# --- Optional ---
# DEEPSEEK_PROFILE_DIR=session/profile   # reuse an existing signed-in Chrome profile
# HOST=127.0.0.1
# PORT=8000
# RATE_LIMIT_PER_MINUTE=30               # per-client-IP limit on /v1 endpoints

# Sessions are loaded from cache by default. The server never logs in, refreshes a
# browser session in the background, or replays a rejected request.
# Missing/expired sessions return 401 login_required, or a terminal SSE error
# after streaming headers are sent. Run the auth CLI manually.
# Restrictions, quota and uncertain upstream failures pause that provider in
# session/provider-pauses.json (HTTP 403; SSE error if headers are already sent).
# Inspect: python -m providers.access status
# After confirming normal website access manually:
#   python -m providers.access resume qwen
# Existing SERVER_INTERACTIVE_LOGIN / SESSION_REFRESH_ENABLED settings no longer
# enable automatic browser capture in the server.

# --- Tool-call truncation handling ---
# DeepSeek's web output limit can cut a large tool call off mid-JSON. When that
# happens it stops without returning partial calls. Continuations are off by
# default. An explicit opt-in (>0) only continues a provider-confirmed output
# limit, never an otherwise finished reply with a missing Markdown fence.
TOOLCALL_MAX_CONTINUATIONS=0
# Optional: one format correction after a normally completed invalid DeepSeek
# tool reply, in the same conversation. Adds at most one paced request. Never
# retries provider refusals, output limits, or uncertain dispatches. Default off.
TOOLCALL_FORMAT_REPAIR=0

# Dump the raw model reply to the log whenever a tool call can't be parsed.
# DEBUG_TOOLCALLS=1
# Save the last invalid tool reply privately under session/, without a history request.
# May contain private source or secrets; disabled by default. Do not publish the file.
# TOOLCALL_DIAGNOSTICS=1
